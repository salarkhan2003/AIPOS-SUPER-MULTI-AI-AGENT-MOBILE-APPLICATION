# Groq — primary agent (fast, JSON mode, Whisper voice)
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — fallback agent (used when Groq fails or is unavailable)
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here

# For EAS APK builds: keys must exist when you run `eas build`.
# Option A: keep this .env file in aipos/ (EAS reads it during cloud build)
# Option B: eas env:create --name EXPO_PUBLIC_GROQ_API_KEY --value gsk_... --environment preview
